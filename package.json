{
  "name": "ai-video-platform",
  "version": "0.2.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "check:functions": "find functions shared -name '*.js' -print0 | xargs -0 -n1 node --check",
    "synth": "cd infra && npx cdk synth",
    "build:frontend": "cd frontend && npm run build",
    "preflight": "node scripts/preflight-check.js",
    "test:integration": "jest tests/integration --runInBand"
  },
  "dependencies": {
    "@aws-sdk/client-apigatewaymanagementapi": "^3.600.0",
    "@aws-sdk/client-bedrock-runtime": "^3.600.0",
    "@aws-sdk/client-cloudfront": "^3.600.0",
    "@aws-sdk/client-dynamodb": "^3.600.0",
    "@aws-sdk/client-eventbridge": "^3.600.0",
    "@aws-sdk/client-mediaconvert": "^3.600.0",
    "@aws-sdk/client-rekognition": "^3.600.0",
    "@aws-sdk/client-s3": "^3.600.0",
    "@aws-sdk/client-secrets-manager": "^3.600.0",
    "@aws-sdk/client-sfn": "^3.600.0",
    "@aws-sdk/client-transcribe": "^3.600.0",
    "@aws-sdk/client-translate": "^3.600.0",
    "@aws-sdk/cloudfront-signer": "^3.600.0",
    "@aws-sdk/lib-dynamodb": "^3.600.0",
    "@aws-sdk/s3-request-presigner": "^3.600.0"
  },
  "devDependencies": {
    "jest": "^29.7.0"
  }
}
